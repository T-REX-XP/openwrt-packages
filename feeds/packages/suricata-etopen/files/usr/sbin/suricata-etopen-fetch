#!/bin/sh
# Fetch enabled ET Open / custom rule tarballs — not the SRM 9840 snapshot.
# Writes /tmp/tp_etopen.json for LuCI. Designed to run under procd, not
# inside an rpcd 30s ubus call.

set -u

OFFICIAL='https://rules.emergingthreats.net/open/suricata-8.0/emerging.rules.tar.gz'
RULE_DIR=$(uci -q get suricata.main.rule_dir 2>/dev/null || echo /etc/suricata/rules)
STATUS=/tmp/tp_etopen.json
STAMP=/var/lib/threat-prevention/etopen.stamp
LOCK=/var/run/suricata-etopen-fetch.lock
CA=/etc/ssl/certs/ca-certificates.crt
LOG=/tmp/tp_etopen_fetch.log
URL=''

json_escape() {
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/	/\\t/g' | tr '\n\r' '  '
}

collect_feeds() {
	local secs sec en url name
	secs=$(uci -q show suricata 2>/dev/null | sed -n 's/^suricata\.\([^=]*\)=etopen$/\1/p')
	if [ -z "$secs" ]; then
		url=$(uci -q get suricata.main.etopen_url 2>/dev/null || true)
		[ -n "$url" ] || url="$OFFICIAL"
		printf '%s\t%s\t%s\n' official "$url" "Official ET Open 8.0"
		return
	fi
	for sec in $secs; do
		[ -n "$sec" ] || continue
		en=$(uci -q get "suricata.${sec}.enabled" 2>/dev/null || echo 1)
		[ "$en" = 0 ] && continue
		url=$(uci -q get "suricata.${sec}.url" 2>/dev/null || true)
		name=$(uci -q get "suricata.${sec}.name" 2>/dev/null || echo "$sec")
		[ -n "$url" ] || continue
		printf '%s\t%s\t%s\n' "$sec" "$url" "$name"
	done
}

write_status() {
	local state="$1"
	local err="${2:-}"
	local mtime="${3:-}"
	local count="${4:-0}"
	local url_j err_j

	url_j=$(json_escape "$URL")
	err_j=$(json_escape "$err")
	cat > "$STATUS" <<EOF
{"etopen_state":"$state","etopen_url":"$url_j","etopen_mtime":"$mtime","etopen_files":$count,"etopen_error":"$err_j","rule_dir":"$RULE_DIR"}
EOF
}

fail() {
	local msg="$1"
	local mtime="" count=0
	count=$(find "$RULE_DIR" -name '*.rules' 2>/dev/null | wc -l | tr -d ' ')
	[ -n "$count" ] || count=0
	if [ -f "$STAMP" ]; then
		mtime=$(awk '{print $1}' "$STAMP")
	fi
	write_status error "$msg" "$mtime" "$count"
	logger -t suricata-etopen "$msg"
	echo "$msg" >&2
	exit 1
}

mkdir -p "$RULE_DIR" /var/lib/threat-prevention /tmp /var/run

if command -v flock >/dev/null 2>&1; then
	exec 9>"$LOCK"
	if ! flock -n 9; then
		echo "etopen: fetch already running" >&2
		exit 0
	fi
fi

FEEDS=$(collect_feeds)
if [ -z "$FEEDS" ]; then
	URL=''
	write_status fetching
	fail "No enabled rule feeds. Add a feed on the Rules tab."
fi
URL=$(printf '%s\n' "$FEEDS" | awk -F '\t' '{print $2}' | paste -sd, -)

write_status fetching

tmp=$(mktemp)
workdir=
cleanup() {
	rm -f "$tmp"
	[ -n "${workdir:-}" ] && rm -rf "$workdir"
}
trap cleanup EXIT

have_default_route() {
	ip -4 route show default 2>/dev/null | grep -q . && return 0
	ip -6 route show default 2>/dev/null | grep -v 'dev lo' | grep -q . && return 0
	return 1
}

url_host() {
	printf '%s' "$1" | sed -e 's|^[a-zA-Z][a-zA-Z0-9+.-]*://||' -e 's|/.*||' -e 's|:.*||'
}

preflight() {
	local wan_dev car host first

	if [ -n "${ETOPEN_TARBALL:-}" ]; then
		return 0
	fi

	wan_dev=$(uci -q get network.wan.device 2>/dev/null || echo eth0)
	car=
	if [ -r "/sys/class/net/${wan_dev}/carrier" ]; then
		car=$(cat "/sys/class/net/${wan_dev}/carrier" 2>/dev/null || echo)
	fi

	if ! have_default_route; then
		if [ "$car" = "0" ]; then
			fail "Unable to download rule feeds: WAN (${wan_dev}) has no link and the router has no default route. Connect the WAN port, then retry."
		fi
		fail "Unable to download rule feeds: the router has no default route (WAN may be down or DHCP has no lease)."
	fi

	first=$(printf '%s\n' "$FEEDS" | awk -F '\t' 'NR==1 {print $2}')
	host=$(url_host "$first")
	case "$host" in
		''|*[!0-9.]* )
			if [ -n "$host" ] && command -v nslookup >/dev/null 2>&1; then
				if ! nslookup "$host" >/dev/null 2>&1; then
					fail "Unable to download rule feeds: DNS lookup for ${host} failed (no upstream resolvers?)."
				fi
			fi
			;;
	esac

	if [ ! -r "$CA" ]; then
		fail "Unable to download rule feeds: CA bundle missing (${CA}). Install ca-bundle."
	fi
}

download_url() {
	local dest="$1"
	local src="$2"
	local rc args

	: > "$LOG"
	if command -v uclient-fetch >/dev/null 2>&1; then
		args="-4 --timeout=120 --proxy=off -O $dest"
		[ -r "$CA" ] && args="$args --ca-certificate=$CA"
		# shellcheck disable=SC2086
		uclient-fetch $args "$src" >"$LOG" 2>&1
		rc=$?
		if [ "$rc" -ne 0 ]; then
			uclient-fetch --timeout=120 --proxy=off ${CA:+--ca-certificate=$CA} -O "$dest" "$src" >"$LOG" 2>&1
			rc=$?
		fi
		return "$rc"
	fi
	if command -v wget >/dev/null 2>&1; then
		wget --timeout=120 -O "$dest" "$src" >"$LOG" 2>&1
		return $?
	fi
	fail "Unable to download rule feeds: no uclient-fetch/wget"
}

install_blob() {
	local blob="$1"
	local feed_id="$2"
	local n dest

	if tar -tzf "$blob" >/dev/null 2>&1; then
		workdir=$(mktemp -d)
		tar -xzf "$blob" -C "$workdir" || return 1
		find "$workdir" -type f -name '*.rules' -exec cp {} "$RULE_DIR/" \;
		find "$workdir" -type f -name 'classification.config' -exec cp {} /etc/suricata/classification.config \; 2>/dev/null || true
		n=$(find "$workdir" -type f -name '*.rules' | wc -l | tr -d ' ')
		rm -rf "$workdir"
		workdir=
		echo "$n"
		return 0
	fi
	dest="$RULE_DIR/${feed_id}.rules"
	cp "$blob" "$dest"
	echo 1
	return 0
}

preflight

# Refresh from enabled feeds only (keep local.rules).
find "$RULE_DIR" -type f \( -name 'emerging-*.rules' -o -name '*.rules' \) ! -name 'local.rules' -delete 2>/dev/null || true

if [ -n "${ETOPEN_TARBALL:-}" ]; then
	[ -f "$ETOPEN_TARBALL" ] || fail "ET Open tarball not found: $ETOPEN_TARBALL"
	cp "$ETOPEN_TARBALL" "$tmp"
	install_blob "$tmp" local >/dev/null || fail "Failed to install ETOPEN_TARBALL"
else
	feedfile=$(mktemp)
	printf '%s\n' "$FEEDS" > "$feedfile"
	while IFS="$(printf '\t')" read -r feed_id feed_url feed_name; do
		[ -n "$feed_url" ] || continue
		echo "etopen: fetching $feed_name"
		if ! download_url "$tmp" "$feed_url"; then
			rm -f "$feedfile"
			out=$(tr '\n' ' ' < "$LOG" 2>/dev/null | sed 's/  */ /g')
			[ -n "$out" ] || out="download failed"
			fail "Unable to download ${feed_name}: $out"
		fi
		install_blob "$tmp" "$feed_id" >/dev/null || {
			rm -f "$feedfile"
			fail "Failed to install ${feed_name}"
		}
	done < "$feedfile"
	rm -f "$feedfile"
fi

mtime=$(date -Iseconds 2>/dev/null || date)
count=$(find "$RULE_DIR" -name '*.rules' | wc -l | tr -d ' ')
[ -n "$count" ] || count=0
printf '%s\n' "$mtime $URL files=$count" > "$STAMP"

write_status ok "" "$mtime" "$count"
echo "etopen: $count *.rules in $RULE_DIR"
logger -t suricata-etopen "fetched $count *.rules into $RULE_DIR"

if [ -x /usr/sbin/tp-rules-index ]; then
	/usr/sbin/tp-rules-index "$RULE_DIR" || true
fi

if [ -x /usr/sbin/suricata-config-apply ]; then
	/usr/sbin/suricata-config-apply || true
fi

if [ -x /usr/bin/suricata ]; then
	run_yaml=$(uci -q get suricata.main.run_yaml 2>/dev/null || echo /var/run/suricata/suricata.yaml)
	if [ -f "$run_yaml" ]; then
		/usr/bin/suricata -T -c "$run_yaml" || {
			fail "suricata -T failed after installing rules"
		}
	fi
fi

if [ -x /etc/init.d/suricata ]; then
	/etc/init.d/suricata enabled 2>/dev/null && /etc/init.d/suricata reload || true
fi
exit 0
