#!/bin/sh /etc/rc.common
# Oneshot ET Open fetch. Do not enable at boot — LuCI / CLI starts this on demand.
# rpcd timeout is 30s; the tarball download must run under procd, not popen.

START=99
USE_PROCD=1

PROG=/usr/sbin/suricata-etopen-fetch

start_service() {
	[ -x "$PROG" ] || return 1

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	start
}
