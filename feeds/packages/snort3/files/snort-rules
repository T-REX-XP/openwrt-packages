set -o nounset

alias log='logger -s -t "snort-rules[$$]" -p "info"'

COMMUNITY_URL='https://www.snort.org/downloads/community/snort3-community-rules.tar.gz'

expand_feed_url() {
	local url="$1"
	local oink="$2"
	printf '%s' "$url" | sed -e "s|{oinkcode}|${oink}|g" -e "s|\$oinkcode|${oink}|g"
}

collect_rulesets() {
	local secs sec en url name
	secs=$(uci -q show snort 2>/dev/null | sed -n 's/^snort\.\([^=]*\)=ruleset$/\1/p')
	[ -n "$secs" ] || return 1
	for sec in $secs; do
		[ -n "$sec" ] || continue
		[ "$sec" = snort ] && continue
		[ "$sec" = nfq ] && continue
		en=$(uci -q get "snort.${sec}.enabled" 2>/dev/null || echo 1)
		[ "$en" = 0 ] && continue
		url=$(uci -q get "snort.${sec}.url" 2>/dev/null || true)
		name=$(uci -q get "snort.${sec}.name" 2>/dev/null || echo "$sec")
		[ -n "$url" ] || continue
		printf '%s\t%s\t%s\n' "$sec" "$url" "$name"
	done
	return 0
}

stash_old_rules() {
	local rules_dir="$1"
	local old_rules="$2"
	local rules_file
	rm -fr "${old_rules:?}"
	mkdir -p "$old_rules"
	for rules_file in "$rules_dir"/*; do
		[ -e "$rules_file" ] || continue
		log "Stashing '$rules_file' to '$old_rules/'..."
		mv -f "$rules_file" "$old_rules/"
	done
}

install_rules_blob() {
	local blob="$1"
	local dest="$2"
	local work
	work=$(mktemp -d)
	if tar -tzf "$blob" >/dev/null 2>&1; then
		tar xzf "$blob" -C "$work" || { rm -rf "$work"; return 1; }
		find "$work" -type f \( -iname 'includes.rules' -o ! -iname '*.rules' \) -delete
		find "$work" -type f -iname '*.rules' -exec cp {} "$dest/" \;
	else
		cp "$blob" "$dest/$(basename "$blob" .tar.gz).rules"
	fi
	rm -rf "$work"
	return 0
}

download_rules() {
	# Further information:
	#    https://www.snort.org/products#rule_subscriptions
	#    https://www.snort.org/oinkcodes
	local oinkcode=$(uci -q get snort.snort.oinkcode)

	local conf_dir=$(uci -q get snort.snort.config_dir || echo "/etc/snort")
	local rules_dir="$conf_dir/rules"
	local data_dir=$(uci -q get snort.snort.temp_dir || echo "/var/snort.d")
	local data_tar="$data_dir/rules.tar.gz"

	local new_rules
	local rules_file
	local feeds feedfile feed_id feed_url feed_name expanded
	local snortver

	# Make sure everything exists.
	[ -d "$data_dir" ] || mkdir -p "$data_dir"

	if $testing ; then
		log "Generating testing rules..."
		new_rules="$data_dir/testing-rules"
		rm -fr "${new_rules:?}"
		mkdir -p "$new_rules"
		rules_file="$new_rules/testing.rules"
		{
			echo 'alert icmp any any <> any any (msg:"TEST ALERT ICMP v4"; icode:0; itype: 8; sid:99010;)'
			echo 'alert icmp any any <> any any (msg:"TEST ALERT ICMP v6"; icode:0; itype:33; sid:99011;)'
			echo 'alert icmp any any <> any any (msg:"TEST ALERT ICMP v6"; icode:0; itype:34; sid:99012;)'
		} >> "$rules_file"

	else
		if feeds=$(collect_rulesets); then
			if [ -z "$feeds" ]; then
				log "No enabled rule feeds. Enable a feed on the Rules tab."
				exit 1
			fi
		else
			if [ -z "$oinkcode" ]; then
				log "Downloading community rules..."
				feeds=$(printf '%s\t%s\t%s\n' community "$COMMUNITY_URL" "Snort 3 community")
			else
				# Closest Talos snapshot preceding typical OpenWrt builds.
				# See https://www.snort.org/advisories/
				snortver=31470
				log "Downloading subscription rules..."
				feeds=$(printf '%s\t%s\t%s\n' talos \
					"https://www.snort.org/rules/snortrules-snapshot-${snortver}.tar.gz?oinkcode={oinkcode}" \
					"Talos snapshot")
			fi
		fi

		if $backup; then
			stash_old_rules "$rules_dir" "$data_dir/old.rules"
		fi

		new_rules="$data_dir/merged-rules"
		rm -fr "${new_rules:?}"
		mkdir -p "$new_rules"

		feedfile=$(mktemp)
		printf '%s\n' "$feeds" > "$feedfile"
		while IFS="$(printf '\t')" read -r feed_id feed_url feed_name; do
			[ -n "$feed_url" ] || continue
			expanded=$(expand_feed_url "$feed_url" "$oinkcode")
			case "$expanded" in
				*'{oinkcode}'*|*'?oinkcode='|*'$oinkcode'*)
					if [ -z "$oinkcode" ]; then
						rm -f "$feedfile"
						log "Feed '$feed_name' needs an Oinkcode (Rules tab)."
						exit 1
					fi
					;;
			esac
			log "Downloading '$feed_name'..."
			wget "$expanded" -O "$data_tar" 2>&1 | log || {
				rm -f "$feedfile"
				exit 1
			}
			install_rules_blob "$data_tar" "$new_rules" || {
				rm -f "$feedfile"
				log "Failed to install '$feed_name'"
				exit 1
			}
		done < "$feedfile"
		rm -f "$feedfile"

		if [ -z "$(find "$new_rules" -type f -iname '*.rules' 2>/dev/null | head -n 1)" ]; then
			log "No .rules files installed from enabled feeds."
			exit 1
		fi
	fi


	mkdir -p "$conf_dir"
	rm -fr "${rules_dir:?}"
	if $persist; then
		mv -f "$new_rules" "$rules_dir"
	else
		ln -s "$new_rules" "$rules_dir"
	fi

	log "Snort rules loaded, restart snort now."
}

#-------------------------------------------------------------------------------

testing=false
persist=false
backup=false

usage() {
	local msg="$1"
	[ -n "$msg" ] && printf "ERROR: %s\n\n" "$msg"

	cat <<USAGE
Usage:

  $0 [-b/--backup] [-t/--testing] [-p/--persist]

  -b = Attempt to copy current rules to '\$temp_dir/old.rules/' before
       installing new rules.

  -t = Don't download any rules, instead create synthetic testing rules.

  -p = Move the downloaded rules to '\$conf_dir/rules/' (usually '/etc/snort/'),
       so that they persist across reboots and sysupgrades.  If you do not
       specify this option, then the rules are stored in '\$temp_dir', and a
       symbolic link is created to them.

After running 'snort-rules', you should run 'snort-mgr check -v' to verify
that there are no errors.

USAGE
	exit 1
}

while [ "${1:-}" ]; do
	case "$1" in
		-h|--help)
			usage
		;;
		-b|--backup)
			backup=true
		;;
		-t|--testing)
			testing=true
		;;
		-p|--persist)
			persist=true
		;;
		*)
			usage "'$1' is not a valid option"
		;;
	esac
	shift
done

download_rules
