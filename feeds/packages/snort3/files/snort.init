#!/bin/sh /etc/rc.common
# shellcheck disable=SC2039  # "local" not defined in POSIX sh

START=99
STOP=10

USE_PROCD=1
PROG=/usr/bin/snort
MGR=/usr/bin/snort-mgr

validate_snort_section() {
	$MGR -q check || return 1
	uci_validate_section snort snort "${1}" \
		'enabled:bool:0' \
		'manual:bool:0' \
		'config_dir:string' \
		'interface:string'
}

start_service() {
	# If you wish to use application-managed PID file:
	# output.logdir, in the snort lua config, determines the PID file location.
	# Add '--create-pidfile' to the 'command', below.

	local enabled
	local manual
	local config_dir
	local interface
	local temp_dir
	local log_dir
	local config_file

	validate_snort_section snort || {
		echo "Validation failed, try 'snort-mgr check'."
		return 1
	}

	[ "$enabled" = 0 ] && return

	temp_dir=$(uci -q get snort.snort.temp_dir || echo /var/snort.d)
	log_dir=$(uci -q get snort.snort.log_dir || echo /var/log/snort)
	case "$log_dir" in
		/var/log|/var/log/) log_dir=/var/log/snort ;;
	esac
	mkdir -p "$temp_dir" "$log_dir"

	procd_open_instance
	if [ "$manual" = 0 ]; then
		config_file=$($MGR setup)
		procd_set_param command "$PROG" -q -c "${config_file}"
	else
		config_file="${config_dir%/}/snort.lua"
		procd_set_param command $PROG -q -i "$interface" -c "$config_file" --tweaks local
		procd_set_param env SNORT_LUA_PATH="$config_dir"
		procd_set_param file $CONFIGFILE
	fi
	[ -x /sbin/ujail -a -e /etc/capabilities/snort.json ] && {
		chown -R snort:snort "$config_dir" "$temp_dir" "$log_dir"
		[ -n "$config_file" ] && [ -f "$config_file" ] && chown snort:snort "$config_file"
		chmod 0750 "$temp_dir" 2>/dev/null || true
		procd_add_jail snort log
		procd_add_jail_mount "$config_dir" /usr/lib/daq /usr/lib/snort /usr/share/lua
		procd_add_jail_mount_rw "$temp_dir" "$log_dir"
		procd_set_param capabilities /etc/capabilities/snort.json
		procd_set_param user snort
		procd_set_param group snort
		procd_set_param no_new_privs 1
	}
	procd_set_param respawn
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

stop_service()
{
	service_stop "$PROG"
	$MGR teardown
}

service_triggers()
{
	procd_add_reload_trigger "snort"
	procd_add_validation validate_snort_section
}
