#!/bin/sh
# Overlay UCI onto the packaged suricata.yaml → /var/run/suricata/suricata.yaml
# Runs on the router (BusyBox). Default: IDS, small ET profile.

set -e

YAML_IN=$(uci -q get suricata.main.yaml 2>/dev/null || echo /etc/suricata/suricata.yaml)
YAML_OUT=$(uci -q get suricata.main.run_yaml 2>/dev/null || echo /var/run/suricata/suricata.yaml)
IFACE=$(uci -q get suricata.main.interface 2>/dev/null || echo br-lan)
HOME_NET=$(uci -q get suricata.main.home_net 2>/dev/null || echo '[192.168.8.0/24]')
RULE_DIR=$(uci -q get suricata.main.rule_dir 2>/dev/null || echo /etc/suricata/rules)
PROFILE=$(uci -q get suricata.main.rule_profile 2>/dev/null || echo small)
EVE=$(uci -q get suricata.main.eve_path 2>/dev/null || echo /var/log/suricata/eve.json)

SMALL_RULES="emerging-malware.rules emerging-mobile_malware.rules emerging-trojan.rules emerging-worm.rules emerging-exploit.rules emerging-web_server.rules"

if [ ! -f "$YAML_IN" ]; then
	logger -t suricata-config-apply "missing $YAML_IN (install suricata package)"
	exit 1
fi

mkdir -p "$(dirname "$YAML_OUT")" "$RULE_DIR"
mkdir -p "$(dirname "$EVE")" 2>/dev/null || true

tmp=$(mktemp)
cp "$YAML_IN" "$tmp"

yaml_sed() {
	sed "$1" "$tmp" > "$tmp.sed"
	mv "$tmp.sed" "$tmp"
}

esc_home=$(printf '%s' "$HOME_NET" | sed 's/[|&]/\\&/g')
yaml_sed "s|^[[:space:]]*HOME_NET:.*|    HOME_NET: \"$esc_home\"|"
yaml_sed "s|^[[:space:]]*- interface: eth0|  - interface: $IFACE|"
yaml_sed "s|^default-rule-path:.*|default-rule-path: $RULE_DIR|"
eve_base=$(basename "$EVE")
yaml_sed "s|^[[:space:]]*filename: eve.json|      filename: $eve_base|"

THRESHOLD=$(uci -q get suricata.main.threshold_file 2>/dev/null || echo /etc/suricata/threshold.config)
if [ -x /usr/sbin/tp-rules-apply ]; then
	/usr/sbin/tp-rules-apply "$THRESHOLD" || true
fi

META=/var/run/suricata/policy.meta
if [ -x /usr/sbin/tp-policy-apply ]; then
	/usr/sbin/tp-policy-apply "$RULE_DIR" "$META" || true
fi

rules_block="rule-files:"
if [ -f "$META" ]; then
	RULE_SRC=$(sed -n 's/^DIR=//p' "$META" | head -n 1)
	[ -n "$RULE_SRC" ] || RULE_SRC=$RULE_DIR
	yaml_sed "s|^default-rule-path:.*|default-rule-path: $RULE_SRC|"
	while IFS= read -r line; do
		case "$line" in
			FILE=*)
				rules_block="${rules_block}
  - ${line#FILE=}"
				;;
		esac
	done < "$META"
elif [ "$PROFILE" = full ]; then
	if [ -f "$RULE_DIR/suricata.rules" ]; then
		rules_block="${rules_block}
  - suricata.rules"
	else
		for f in "$RULE_DIR"/emerging-*.rules; do
			[ -f "$f" ] || continue
			rules_block="${rules_block}
  - $(basename "$f")"
		done
	fi
else
	for name in $SMALL_RULES; do
		[ -f "$RULE_DIR/$name" ] || continue
		rules_block="${rules_block}
  - $name"
	done
fi

echo "$rules_block" | grep -q '  - ' || {
	rules_block="rule-files:
  - local.rules"
	[ -f "$RULE_DIR/local.rules" ] || : > "$RULE_DIR/local.rules"
}

if grep -q '^[[:space:]]*#*threshold-file:' "$tmp"; then
	yaml_sed "s|^[[:space:]]*#*threshold-file:.*|threshold-file: $THRESHOLD|"
else
	printf '\nthreshold-file: %s\n' "$THRESHOLD" >> "$tmp"
fi

PATTERN=$(uci -q get suricata.main.pattern_algo 2>/dev/null || echo auto)
case "$PATTERN" in
	auto|hs|ac) ;;
	*) PATTERN=auto ;;
esac
if [ "$PATTERN" = hs ]; then
	BUILDINFO=$(suricata --build-info 2>/dev/null || true)
	echo "$BUILDINFO" | grep -q 'Hyperscan support:[[:space:]]*yes' || {
		logger -t suricata-config-apply "Hyperscan requested but not in this build; using auto"
		PATTERN=auto
	}
fi
if [ "$PATTERN" = hs ]; then
	MPM=hs
	SPM=hs
elif [ "$PATTERN" = ac ]; then
	MPM=ac
	SPM=bm
else
	MPM=auto
	SPM=auto
fi
if grep -q '^[[:space:]]*#*mpm-algo:' "$tmp"; then
	yaml_sed "s|^[[:space:]]*#*mpm-algo:.*|mpm-algo: $MPM|"
else
	printf '\nmpm-algo: %s\n' "$MPM" >> "$tmp"
fi
if grep -q '^[[:space:]]*#*spm-algo:' "$tmp"; then
	yaml_sed "s|^[[:space:]]*#*spm-algo:.*|spm-algo: $SPM|"
else
	printf '\nspm-algo: %s\n' "$SPM" >> "$tmp"
fi

BYPASS=$(uci -q get suricata.main.flow_bypass 2>/dev/null || echo 0)
if [ "$BYPASS" = 1 ] || [ "$BYPASS" = yes ] || [ "$BYPASS" = true ]; then
	BYPASS_YAML=yes
else
	BYPASS_YAML=no
fi
yaml_sed "s|^  #*bypass:.*|  bypass: $BYPASS_YAML|"
yaml_sed "s|^    #*bypass:.*|    bypass: $BYPASS_YAML|"

printf '%s\n' "$rules_block" > "$tmp.rulesblock"
awk -v rf="$tmp.rulesblock" '
  BEGIN { skip=0 }
  /^rule-files:/ {
    while ((getline line < rf) > 0) print line
    close(rf)
    skip=1
    next
  }
  skip==1 {
    if ($0 ~ /^[^[:space:]#]/ && $0 !~ /^rule-files:/) { skip=0 }
    else next
  }
  skip==0 { print }
' "$tmp" > "$tmp.new"
rm -f "$tmp.rulesblock"
mv "$tmp.new" "$tmp"

mkdir -p "$(dirname "$EVE")"
mv "$tmp" "$YAML_OUT"
chmod 644 "$YAML_OUT"
exit 0
