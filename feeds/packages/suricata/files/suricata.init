#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

PROG=/usr/bin/suricata

start_service() {
	local enabled mode iface run_yaml capture

	config_load suricata
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0

	config_get mode main mode ids
	config_get iface main interface br-lan
	config_get run_yaml main run_yaml /var/run/suricata/suricata.yaml
	config_get capture main capture af-packet

	[ "$mode" = ids ] || {
		logger -t suricata "mode=$mode not supported yet (IDS only); not starting"
		return 1
	}

	[ -x /usr/sbin/suricata-config-apply ] || return 1
	/usr/sbin/suricata-config-apply || {
		logger -t suricata "suricata-config-apply failed"
		return 1
	}

	mkdir -p /var/log/suricata /var/run/suricata

	if [ "$capture" = dpdk ]; then
		if "$PROG" --build-info 2>/dev/null | grep -q 'DPDK support:[[:space:]]*yes'; then
			:
		else
			logger -t suricata "DPDK requested but not in this Suricata build; using AF_PACKET"
			capture=af-packet
		fi
	fi

	procd_open_instance
	if [ "$capture" = dpdk ]; then
		procd_set_param command "$PROG" -c "$run_yaml" --dpdk
	else
		procd_set_param command "$PROG" -c "$run_yaml" --af-packet="$iface"
	fi
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger 'suricata'
}
