#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

PROG=/usr/bin/suricata

start_service() {
	local enabled mode iface run_yaml

	config_load suricata
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0

	config_get mode main mode ids
	config_get iface main interface br-lan
	config_get run_yaml main run_yaml /var/run/suricata/suricata.yaml

	[ "$mode" = ids ] || {
		logger -t suricata "mode=$mode not supported yet (IDS only); not starting"
		return 1
	}

	[ -x /usr/sbin/suricata-config-apply ] || return 1
	/usr/sbin/suricata-config-apply || {
		logger -t suricata "suricata-config-apply failed"
		return 1
	}

	mkdir -p /var/log/suricata /var/run/suricata

	procd_open_instance
	procd_set_param command "$PROG" -c "$run_yaml" --af-packet="$iface"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger 'suricata'
}
