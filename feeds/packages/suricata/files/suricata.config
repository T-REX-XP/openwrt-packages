config suricata 'main'
	option enabled '0'
	option mode 'ids'
	option interface 'br-lan'
	option home_net '[192.168.8.0/24]'
	option eve_path '/var/log/suricata/eve.json'
	option rule_dir '/etc/suricata/rules'
	option rule_profile 'small'
	option fail_open '1'
	option yaml '/etc/suricata/suricata.yaml'
	option run_yaml '/var/run/suricata/suricata.yaml'

config classtype
	option name 'trojan-activity'
	option action 'alert'

config classtype
	option name 'attempted-admin'
	option action 'alert'

config classtype
	option name 'web-application-attack'
	option action 'alert'

config classtype
	option name 'successful-admin'
	option action 'alert'
