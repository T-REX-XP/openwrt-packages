#!/bin/sh
# Drop catalog lists whose download URLs 404 (HaGeZi legacy domains/hosts,
# NextDNS metadata paths, Phishing.Database raw file). Keep other UCI lists.

[ -f /etc/config/blocky ] || exit 0

changed=0
for sid in \
	hagezi_light hagezi_pro hagezi_tif_medium hagezi_gambling \
	phishing_database \
	nextdns_windows nextdns_apple nextdns_samsung nextdns_xiaomi nextdns_huawei
do
	if uci -q get "blocky.$sid" >/dev/null 2>&1; then
		uci -q delete "blocky.$sid"
		changed=1
	fi
done

[ "$changed" = "1" ] || exit 0

uci -q commit blocky
[ -x /usr/sbin/blocky-lists-sync ] && /usr/sbin/blocky-lists-sync >/dev/null 2>&1 || true

exit 0
