#!/bin/sh
# Build /etc/suricata/threshold.config from UCI sid suppressions.
# Disabled SIDs use Suricata suppress so ET Open fetches can overwrite
# rule files without losing operator disables.

set -eu

OUT=${1:-/etc/suricata/threshold.config}
TMP=$(mktemp)
trap 'rm -f "$TMP"' EXIT

mkdir -p "$(dirname "$OUT")"

{
	echo "# generated by tp-rules-apply — do not edit"
	if command -v uci >/dev/null 2>&1; then
		uci -q show suricata 2>/dev/null | sed -n 's/^suricata\.s\([0-9][0-9]*\)=sid$/\1/p' | while read -r sid; do
			[ -n "$sid" ] || continue
			en=$(uci -q get "suricata.s${sid}.enabled" 2>/dev/null || echo 1)
			gid=$(uci -q get "suricata.s${sid}.gid" 2>/dev/null || echo 1)
			case "$gid" in
				''|*[!0-9]*) gid=1 ;;
			esac
			[ "$en" = 0 ] || continue
			echo "suppress gen_id $gid, sig_id $sid"
		done
	fi
} > "$TMP"

mv "$TMP" "$OUT"
chmod 644 "$OUT"
trap - EXIT
exit 0
