#!/bin/sh
# Build /etc/suricata/threshold.config from UCI SID tunings.
# Disabled/expired SIDs use suppress so ET Open fetches can overwrite
# rule files without losing operator disables. Threshold lines apply
# rate limits without rewriting vendor signatures.

set -eu

OUT=${1:-/etc/suricata/threshold.config}
TMP=$(mktemp)
trap 'rm -f "$TMP"' EXIT

mkdir -p "$(dirname "$OUT")"

thresh_ok() {
	echo "$1" | grep -qE '^type (limit|threshold|both), track (by_src|by_dst), count [0-9]+, seconds [0-9]+$'
}

{
	echo "# generated by tp-rules-apply — do not edit"
	if command -v uci >/dev/null 2>&1; then
		uci -q show suricata 2>/dev/null | sed -n 's/^suricata\.s\([0-9][0-9]*\)=sid$/\1/p' | while read -r sid; do
			[ -n "$sid" ] || continue
			en=$(uci -q get "suricata.s${sid}.enabled" 2>/dev/null || echo 1)
			status=$(uci -q get "suricata.s${sid}.status" 2>/dev/null || echo enabled)
			gid=$(uci -q get "suricata.s${sid}.gid" 2>/dev/null || echo 1)
			thresh=$(uci -q get "suricata.s${sid}.threshold" 2>/dev/null || true)
			case "$gid" in
				''|*[!0-9]*) gid=1 ;;
			esac
			if [ "$en" = 0 ] || [ "$status" = disabled ] || [ "$status" = expired ]; then
				echo "suppress gen_id $gid, sig_id $sid"
				continue
			fi
			if [ -n "$thresh" ] && thresh_ok "$thresh"; then
				echo "threshold gen_id $gid, sig_id $sid, $thresh"
			fi
		done
	fi
} > "$TMP"

mv "$TMP" "$OUT"
chmod 644 "$OUT"
trap - EXIT
exit 0
