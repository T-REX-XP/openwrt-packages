#!/bin/sh
# Filter Suricata EVE or Snort alert_json and send Telegram / ntfy / webhook / Discord / email.
# Usage:
#   echo '<json>' | tp-notify                  # process one line (sync)
#   echo '<json>' | tp-notify --enqueue        # queue + background worker
#   tp-notify --test <section-id>              # synthetic alert, skip filters
#   tp-notify --status                         # JSON status (no secrets)
#
# UCI package: TP_NOTIFY_UCI=suricata|snort (default suricata)
# Test hooks: TP_NOTIFY_DRY_RUN=1 TP_NOTIFY_STATE=dir TP_NOTIFY_NOW=epoch
#             TP_NOTIFY_HOST=name TP_NOTIFY_CURL=curl TP_NOTIFY_MSMTP=msmtp
#             TP_NOTIFY_ENGINE=Snort|Suricata

UCI_PKG=${TP_NOTIFY_UCI:-suricata}
case "$UCI_PKG" in
	snort|suricata) ;;
	*) UCI_PKG=suricata ;;
esac
STATE=${TP_NOTIFY_STATE:-/tmp/tp-notify-state}
QDIR=${TP_NOTIFY_QUEUE:-/tmp/tp-notify-queue-$UCI_PKG}
LOCK=${TP_NOTIFY_LOCK:-/tmp/tp-notify.$UCI_PKG.worker.lock}
DRY=${TP_NOTIFY_DRY_RUN:-0}
CURL=${TP_NOTIFY_CURL:-curl}
MSMTP=${TP_NOTIFY_MSMTP:-msmtp}
HOST=${TP_NOTIFY_HOST:-}
ENGINE=${TP_NOTIFY_ENGINE:-}
TP_HTTP=000

now_epoch() {
	if [ -n "$TP_NOTIFY_NOW" ]; then
		echo "$TP_NOTIFY_NOW"
	else
		date +%s
	fi
}

log_msg() {
	logger -t tp-notify "$*" 2>/dev/null || true
}

json_get() {
	_line=$1
	_path=$2
	if [ -n "$JSONFILTER" ]; then
		"$JSONFILTER" -s "$_line" -e "$_path" 2>/dev/null || true
	elif command -v jsonfilter >/dev/null 2>&1; then
		jsonfilter -s "$_line" -e "$_path" 2>/dev/null || true
	else
		LINE=$_line PATHQ=$_path python3 -c '
import json, os, sys
raw, path = os.environ["LINE"], os.environ["PATHQ"]
try:
    obj = json.loads(raw)
except Exception:
    sys.exit(0)
key = path[2:] if path.startswith("@.") else path.lstrip("@.")
cur = obj
for part in key.split("."):
    if not isinstance(cur, dict) or part not in cur:
        sys.exit(0)
    cur = cur[part]
if cur is None:
    sys.exit(0)
print(cur)
' 2>/dev/null || true
	fi
}

json_esc() {
	printf '%s' "$1" | awk 'BEGIN { ORS="" } {
		gsub(/\\/, "\\\\")
		gsub(/"/, "\\\"")
		gsub(/\t/, "\\t")
		gsub(/\r/, "")
		gsub(/\n/, " ")
		print
	}'
}

safe_field() {
	printf '%s' "$1" | tr '|\n\r' '///' | cut -c1-200
}

uci_q() {
	uci -q get "$1" 2>/dev/null || true
}

list_notify_ids() {
	uci -q show "$UCI_PKG" 2>/dev/null | sed -n "s/^${UCI_PKG}\\.\\([^=]*\\)=notify$/\\1/p"
}

engine_name() {
	if [ -n "$ENGINE" ]; then
		printf '%s' "$ENGINE"
		return
	fi
	if [ "$UCI_PKG" = snort ]; then
		printf '%s' Snort
	else
		printf '%s' Suricata
	fi
}

source_name() {
	engine_name | tr 'A-Z' 'a-z'
}

json_pick() {
	_line=$1
	shift
	for _path in "$@"; do
		_v=$(json_get "$_line" "$_path")
		if [ -n "$_v" ]; then
			printf '%s' "$_v"
			return 0
		fi
	done
	return 1
}

host_name() {
	if [ -n "$HOST" ]; then
		printf '%s' "$HOST"
		return
	fi
	h=$(uci_q system.@system[0].hostname)
	[ -n "$h" ] || h=$(uname -n 2>/dev/null || echo OpenWrt)
	printf '%s' "$h"
}

redact_ip() {
	ip=$1
	case "$ip" in
		*.*.*.*)
			printf '%s' "$ip" | sed 's/\.[0-9][0-9]*$/.0/'
			;;
		*:*)
			printf '%s' "$ip" | awk -F: '{
				if (NF >= 4) printf "%s:%s:%s:%s::", $1, $2, $3, $4
				else print $0
			}'
			;;
		*)
			printf '%s' "$ip"
			;;
	esac
}

status_path() {
	printf '%s/%s.%s.status' "$STATE" "$UCI_PKG" "$1"
}

read_status_field() {
	_sp=$(status_path "$1")
	[ -f "$_sp" ] || { echo 0; return; }
	case "$2" in
		sent) sed -n 's/.*"sent":\([0-9][0-9]*\).*/\1/p' "$_sp" | head -n 1 ;;
		suppressed) sed -n 's/.*"suppressed":\([0-9][0-9]*\).*/\1/p' "$_sp" | head -n 1 ;;
		http) sed -n 's/.*"http":"\([^"]*\)".*/\1/p' "$_sp" | head -n 1 ;;
		last_ok) sed -n 's/.*"last_ok":"\([^"]*\)".*/\1/p' "$_sp" | head -n 1 ;;
		last_err) sed -n 's/.*"last_err":"\([^"]*\)".*/\1/p' "$_sp" | head -n 1 ;;
		*) echo 0 ;;
	esac
}

write_status() {
	id=$1
	last_ok=$2
	last_err=$3
	http=$4
	sent=$5
	suppressed=$6
	mkdir -p "$STATE"
	printf '{"id":"%s","last_ok":"%s","last_err":"%s","http":"%s","sent":%s,"suppressed":%s}\n' \
		"$id" "$(json_esc "$last_ok")" "$(json_esc "$last_err")" "$(json_esc "$http")" \
		"${sent:-0}" "${suppressed:-0}" > "$(status_path "$id")"
}

inc_suppressed() {
	id=$1
	sent=$(read_status_field "$id" sent)
	sup=$(read_status_field "$id" suppressed)
	ok=$(read_status_field "$id" last_ok)
	err=$(read_status_field "$id" last_err)
	http=$(read_status_field "$id" http)
	[ -n "$sent" ] || sent=0
	[ -n "$sup" ] || sup=0
	write_status "$id" "$ok" "$err" "$http" "$sent" "$((sup + 1))"
}

rate_ok() {
	id=$1
	limit=$2
	[ -n "$limit" ] || limit=12
	[ "$limit" -gt 0 ] 2>/dev/null || return 0
	rf="$STATE/${UCI_PKG}.$id.rate"
	n=$(now_epoch)
	mkdir -p "$STATE"
	w=0
	c=0
	if [ -f "$rf" ]; then
		read w c < "$rf" || true
	fi
	[ -n "$w" ] || w=0
	[ -n "$c" ] || c=0
	if [ $((n - w)) -ge 3600 ]; then
		w=$n
		c=0
	fi
	if [ "$c" -ge "$limit" ]; then
		echo "$w $c" > "$rf"
		return 1
	fi
	echo "$w $((c + 1))" > "$rf"
	return 0
}

text_alert() {
	if [ -n "$DIGEST_TEXT" ]; then
		printf '%s' "$DIGEST_TEXT"
		return
	fi
	printf '%s %s\nSID %s %s\n%s %s:%s -> %s:%s (%s)\nseverity %s class %s' \
		"$(engine_name)" "$(host_name)" "$A_SID" "$A_MSG" "$A_PROTO" "$A_SRC" "$A_SPORT" \
		"$A_DST" "$A_DPORT" "$A_TS" "$A_SEV" "$A_CLS"
}

json_alert() {
	if [ -n "$DIGEST_TEXT" ]; then
		printf '{"source":"%s","host":"%s","mode":"digest","message":"%s"}' \
			"$(json_esc "$(source_name)")" "$(json_esc "$(host_name)")" "$(json_esc "$DIGEST_TEXT")"
		return
	fi
	printf '{"source":"%s","host":"%s","ts":"%s","sid":%s,"gid":%s,"msg":"%s","classtype":"%s","severity":%s,"src":"%s","sport":"%s","dst":"%s","dport":"%s","proto":"%s"}' \
		"$(json_esc "$(source_name)")" "$(json_esc "$(host_name)")" "$(json_esc "$A_TS")" "${A_SID:-0}" "${A_GID:-1}" \
		"$(json_esc "$A_MSG")" "$(json_esc "$A_CLS")" "${A_SEV:-3}" \
		"$(json_esc "$A_SRC")" "$(json_esc "$A_SPORT")" \
		"$(json_esc "$A_DST")" "$(json_esc "$A_DPORT")" "$(json_esc "$A_PROTO")"
}

discord_json() {
	printf '{"content":"%s"}' "$(json_esc "$(text_alert)")"
}

http_code_ok() {
	case "$1" in
		2??) return 0 ;;
		*) return 1 ;;
	esac
}

send_telegram() {
	token=$1
	chat=$2
	body=$(text_alert)
	if [ "$DRY" = 1 ]; then
		echo "SEND telegram chat_id=$chat"
		echo "BODY $body"
		TP_HTTP=200
		return 0
	fi
	TP_HTTP=000
	if ! command -v "$CURL" >/dev/null 2>&1; then
		return 1
	fi
	out="$STATE/.http.$$"
	mkdir -p "$STATE"
	TP_HTTP=$("$CURL" -sS --max-time 8 --retry 0 -o "$out" -w '%{http_code}' \
		--data-urlencode "chat_id=$chat" \
		--data-urlencode "text=$body" \
		"https://api.telegram.org/bot${token}/sendMessage" 2>/dev/null || echo 000)
	rm -f "$out"
	http_code_ok "$TP_HTTP"
}

ntfy_priority() {
	case "$1" in
		1) echo 5 ;;
		2) echo 4 ;;
		*) echo 3 ;;
	esac
}

send_ntfy() {
	base=$1
	topic=$2
	token=$3
	body=$(text_alert)
	base=${base%/}
	url="$base/$topic"
	pri=$(ntfy_priority "$A_SEV")
	if [ "$DRY" = 1 ]; then
		echo "SEND ntfy $url priority=$pri"
		echo "BODY $body"
		TP_HTTP=200
		return 0
	fi
	TP_HTTP=000
	if ! command -v "$CURL" >/dev/null 2>&1; then
		return 1
	fi
	out="$STATE/.http.$$"
	mkdir -p "$STATE"
	if [ -n "$token" ]; then
		TP_HTTP=$("$CURL" -sS --max-time 8 --retry 0 -o "$out" -w '%{http_code}' \
			-H "Title: $(engine_name)" -H "Priority: $pri" \
			-H "Authorization: Bearer $token" \
			-d "$body" "$url" 2>/dev/null || echo 000)
	else
		TP_HTTP=$("$CURL" -sS --max-time 8 --retry 0 -o "$out" -w '%{http_code}' \
			-H "Title: $(engine_name)" -H "Priority: $pri" \
			-d "$body" "$url" 2>/dev/null || echo 000)
	fi
	rm -f "$out"
	http_code_ok "$TP_HTTP"
}

send_webhook() {
	url=$1
	header=$2
	body=$(json_alert)
	if [ "$DRY" = 1 ]; then
		echo "SEND webhook $url"
		echo "BODY $body"
		TP_HTTP=200
		return 0
	fi
	TP_HTTP=000
	if ! command -v "$CURL" >/dev/null 2>&1; then
		return 1
	fi
	out="$STATE/.http.$$"
	mkdir -p "$STATE"
	if [ -n "$header" ]; then
		TP_HTTP=$("$CURL" -sS --max-time 8 --retry 0 -o "$out" -w '%{http_code}' \
			-H "Content-Type: application/json" -H "$header" \
			-d "$body" "$url" 2>/dev/null || echo 000)
	else
		TP_HTTP=$("$CURL" -sS --max-time 8 --retry 0 -o "$out" -w '%{http_code}' \
			-H "Content-Type: application/json" \
			-d "$body" "$url" 2>/dev/null || echo 000)
	fi
	rm -f "$out"
	http_code_ok "$TP_HTTP"
}

send_discord() {
	url=$1
	body=$(discord_json)
	if [ "$DRY" = 1 ]; then
		echo "SEND discord $url"
		echo "BODY $body"
		TP_HTTP=200
		return 0
	fi
	TP_HTTP=000
	if ! command -v "$CURL" >/dev/null 2>&1; then
		return 1
	fi
	out="$STATE/.http.$$"
	mkdir -p "$STATE"
	TP_HTTP=$("$CURL" -sS --max-time 8 --retry 0 -o "$out" -w '%{http_code}' \
		-H "Content-Type: application/json" \
		-d "$body" "$url" 2>/dev/null || echo 000)
	rm -f "$out"
	http_code_ok "$TP_HTTP"
}

send_email() {
	to=$1
	account=$2
	[ -n "$account" ] || account=${UCI_PKG}_notify
	subj="[$(engine_name)] SID $A_SID $A_MSG"
	body=$(text_alert)
	if [ "$DRY" = 1 ]; then
		echo "SEND email to=$to account=$account"
		echo "SUBJECT $subj"
		echo "BODY $body"
		TP_HTTP=200
		return 0
	fi
	TP_HTTP=000
	if ! command -v "$MSMTP" >/dev/null 2>&1; then
		return 1
	fi
	if printf 'Subject: %s\n\n%s\n' "$subj" "$body" | "$MSMTP" -a "$account" "$to"; then
		TP_HTTP=200
		return 0
	fi
	return 1
}

channel_ready() {
	id=$1
	typ=$2
	case "$typ" in
		telegram)
			[ -n "$(uci_q ${UCI_PKG}.$id.bot_token)" ] && [ -n "$(uci_q ${UCI_PKG}.$id.chat_id)" ]
			;;
		ntfy)
			[ -n "$(uci_q ${UCI_PKG}.$id.topic)" ]
			;;
		webhook|discord)
			[ -n "$(uci_q ${UCI_PKG}.$id.url)" ]
			;;
		email)
			[ -n "$(uci_q ${UCI_PKG}.$id.to)" ]
			;;
		*)
			return 1
			;;
	esac
}

in_list() {
	needle=$1
	list=$2
	[ -n "$list" ] || return 1
	oldifs=$IFS
	IFS=', '
	# shellcheck disable=SC2086
	set -- $list
	IFS=$oldifs
	for x in "$@"; do
		[ "$x" = "$needle" ] && return 0
	done
	return 1
}

filter_match() {
	id=$1
	min=$(uci_q ${UCI_PKG}.$id.min_severity)
	[ -n "$min" ] || min=1
	sev=${A_SEV:-3}
	case "$sev" in [0-9]*) ;; *) sev=3 ;; esac
	case "$min" in [0-9]*) ;; *) min=1 ;; esac
	[ "$sev" -le "$min" ] || return 1
	cls_f=$(uci_q ${UCI_PKG}.$id.classtype)
	if [ -n "$cls_f" ]; then
		in_list "$A_CLS" "$cls_f" || return 1
	fi
	allow=$(uci_q ${UCI_PKG}.$id.sid_allow)
	if [ -n "$allow" ]; then
		in_list "$A_SID" "$allow" || return 1
	fi
	deny=$(uci_q ${UCI_PKG}.$id.sid_deny)
	if [ -n "$deny" ]; then
		in_list "$A_SID" "$deny" && return 1
	fi
	return 0
}

apply_redact() {
	id=$1
	inc=$(uci_q ${UCI_PKG}.$id.include_lan)
	[ -n "$inc" ] || inc=1
	if [ "$inc" = 0 ]; then
		A_SRC=$(redact_ip "$A_SRC")
		A_DST=$(redact_ip "$A_DST")
	fi
}

digest_append() {
	id=$1
	mkdir -p "$STATE"
	printf '%s|%s|%s|%s|%s|%s\n' \
		"$(safe_field "$A_SID")" "$(safe_field "$A_MSG")" "$(safe_field "$A_CLS")" \
		"$(safe_field "$A_SRC")" "$(safe_field "$A_DST")" "$(safe_field "$A_SEV")" \
		>> "$STATE/${UCI_PKG}.$id.digest"
}

digest_body() {
	id=$1
	df="$STATE/${UCI_PKG}.$id.digest"
	[ -f "$df" ] || return 0
	awk -F'|' -v host="$(host_name)" '
	{
		sid=$1; msg=$2; src=$4; dst=$5
		key=sid " " src " " dst
		count[key]++
		msgt[key]=msg
		n++
	}
	END {
		printf "Suricata %s digest\n%d alerts\n", host, n+0
		i=0
		for (k in count) {
			i++
			if (i > 20) break
			split(k, a, " ")
			printf "  %s × %d  %s → %s  %s\n", a[1], count[k], a[2], a[3], msgt[k]
		}
	}' "$df"
}

digest_due() {
	id=$1
	interval=$2
	[ -n "$interval" ] || interval=3600
	case "$interval" in [0-9]*) ;; *) interval=3600 ;; esac
	[ "$interval" -eq 0 ] && return 0
	lf="$STATE/${UCI_PKG}.$id.flush"
	n=$(now_epoch)
	if [ ! -f "$lf" ]; then
		echo "$n" > "$lf"
		return 1
	fi
	last=$(cat "$lf" 2>/dev/null || echo 0)
	[ -n "$last" ] || last=0
	[ $((n - last)) -ge "$interval" ]
}

mark_flush() {
	mkdir -p "$STATE"
	now_epoch > "$STATE/$1.flush"
}

do_send() {
	id=$1
	typ=$(uci_q ${UCI_PKG}.$id.type)
	TP_HTTP=000
	ok=1
	case "$typ" in
		telegram)
			send_telegram "$(uci_q ${UCI_PKG}.$id.bot_token)" "$(uci_q ${UCI_PKG}.$id.chat_id)" || ok=0
			;;
		ntfy)
			base=$(uci_q ${UCI_PKG}.$id.url)
			[ -n "$base" ] || base=https://ntfy.sh
			send_ntfy "$base" "$(uci_q ${UCI_PKG}.$id.topic)" "$(uci_q ${UCI_PKG}.$id.token)" || ok=0
			;;
		webhook)
			send_webhook "$(uci_q ${UCI_PKG}.$id.url)" "$(uci_q ${UCI_PKG}.$id.header)" || ok=0
			;;
		discord)
			send_discord "$(uci_q ${UCI_PKG}.$id.url)" || ok=0
			;;
		email)
			send_email "$(uci_q ${UCI_PKG}.$id.to)" "$(uci_q ${UCI_PKG}.$id.msmtp_account)" || ok=0
			;;
		*)
			ok=0
			;;
	esac
	sent=$(read_status_field "$id" sent)
	sup=$(read_status_field "$id" suppressed)
	[ -n "$sent" ] || sent=0
	[ -n "$sup" ] || sup=0
	if [ "$ok" = 1 ] && http_code_ok "$TP_HTTP"; then
		write_status "$id" "$(now_epoch)" "" "$TP_HTTP" "$((sent + 1))" "$sup"
		log_msg "sent type=$typ id=$id sid=$A_SID http=$TP_HTTP"
		return 0
	fi
	write_status "$id" "$(read_status_field "$id" last_ok)" "http $TP_HTTP" "$TP_HTTP" "$sent" "$sup"
	log_msg "fail type=$typ id=$id sid=$A_SID http=$TP_HTTP"
	return 1
}

flush_digest() {
	id=$1
	df="$STATE/${UCI_PKG}.$id.digest"
	[ -f "$df" ] || return 0
	limit=$(uci_q ${UCI_PKG}.$id.rate_limit)
	[ -n "$limit" ] || limit=12
	if ! rate_ok "$id" "$limit"; then
		inc_suppressed "$id"
		rm -f "$df"
		mark_flush "$id"
		return 0
	fi
	DIGEST_TEXT=$(digest_body "$id")
	A_SID=0
	A_GID=1
	A_MSG=digest
	A_CLS=digest
	A_SRC=
	A_DST=
	A_SPORT=
	A_DPORT=
	A_PROTO=
	A_SEV=1
	A_TS=$(now_epoch)
	do_send "$id" || true
	DIGEST_TEXT=
	rm -f "$df"
	mark_flush "$id"
}

dispatch_channel() {
	id=$1
	skip_filter=$2
	en=$(uci_q ${UCI_PKG}.$id.enabled)
	[ "$en" = 1 ] || return 0
	typ=$(uci_q ${UCI_PKG}.$id.type)
	case "$typ" in
		telegram|ntfy|webhook|discord|email) ;;
		*) return 0 ;;
	esac
	channel_ready "$id" "$typ" || return 0
	if [ "$skip_filter" != 1 ]; then
		filter_match "$id" || return 0
	fi
	apply_redact "$id"
	mode=$(uci_q ${UCI_PKG}.$id.mode)
	[ -n "$mode" ] || mode=digest
	if [ "$skip_filter" = 1 ]; then
		mode=realtime
	fi
	if [ "$mode" = digest ]; then
		digest_append "$id"
		interval=$(uci_q ${UCI_PKG}.$id.interval)
		[ -n "$interval" ] || interval=3600
		digest_due "$id" "$interval" && flush_digest "$id"
		return 0
	fi
	limit=$(uci_q ${UCI_PKG}.$id.rate_limit)
	[ -n "$limit" ] || limit=12
	if ! rate_ok "$id" "$limit"; then
		inc_suppressed "$id"
		return 0
	fi
	do_send "$id" || true
}

parse_alert() {
	line=$1
	et=$(json_get "$line" '@.event_type')
	if [ "$et" = alert ]; then
		A_TS=$(json_get "$line" '@.timestamp')
		A_SRC=$(json_get "$line" '@.src_ip')
		A_DST=$(json_get "$line" '@.dest_ip')
		A_SPORT=$(json_get "$line" '@.src_port')
		A_DPORT=$(json_get "$line" '@.dest_port')
		A_PROTO=$(json_get "$line" '@.proto')
		A_SID=$(json_get "$line" '@.alert.signature_id')
		A_GID=$(json_get "$line" '@.alert.gid')
		A_MSG=$(json_get "$line" '@.alert.signature')
		A_CLS=$(json_get "$line" '@.alert.category')
		A_SEV=$(json_get "$line" '@.alert.severity')
		[ -n "$A_SID" ] || return 1
		return 0
	fi
	A_SID=$(json_pick "$line" '@.sid' '@.alert.signature_id') || return 1
	A_TS=$(json_pick "$line" '@.timestamp' || true)
	A_SRC=$(json_pick "$line" '@.src_addr' '@.src_ip' || true)
	A_DST=$(json_pick "$line" '@.dst_addr' '@.dest_ip' || true)
	A_SPORT=$(json_pick "$line" '@.src_port' || true)
	A_DPORT=$(json_pick "$line" '@.dst_port' '@.dest_port' || true)
	A_PROTO=$(json_pick "$line" '@.proto' || true)
	A_GID=$(json_pick "$line" '@.gid' '@.alert.gid' || true)
	A_MSG=$(json_pick "$line" '@.msg' '@.alert.signature' || true)
	A_CLS=$(json_pick "$line" '@.class' '@.alert.category' || true)
	A_SEV=$(json_pick "$line" '@.priority' '@.alert.severity' || true)
	return 0
}

process_line() {
	line=$1
	[ -n "$line" ] || return 0
	parse_alert "$line" || return 0
	ids=$(list_notify_ids)
	[ -n "$ids" ] || return 0
	for id in $ids; do
		[ -n "$id" ] || continue
		dispatch_channel "$id" 0
	done
}

dump_status() {
	mkdir -p "$STATE"
	printf '{"channels":['
	first=1
	ids=$(list_notify_ids)
	for id in $ids; do
		[ -n "$id" ] || continue
		sp=$(status_path "$id")
		if [ -f "$sp" ]; then
			raw=$(cat "$sp")
		else
			raw=$(printf '{"id":"%s","last_ok":"","last_err":"","http":"","sent":0,"suppressed":0}' "$id")
		fi
		if [ "$first" = 1 ]; then
			first=0
		else
			printf ','
		fi
		printf '%s' "$raw"
	done
	printf ']}\n'
}

synthetic_line() {
	if [ "$UCI_PKG" = snort ]; then
		printf '%s' '{"timestamp":"1970-01-01T00:00:00.000000+0000","proto":"TCP","src_addr":"203.0.113.10","src_port":443,"dst_addr":"192.168.8.1","dst_port":1,"gid":1,"sid":1,"rev":1,"action":"allow","msg":"Snort notify test","class":"not-suspicious","priority":1}'
		return
	fi
	printf '%s' '{"timestamp":"1970-01-01T00:00:00.000000+0000","event_type":"alert","src_ip":"203.0.113.10","src_port":443,"dest_ip":"192.168.8.1","dest_port":1,"proto":"TCP","alert":{"gid":1,"signature_id":1,"signature":"Suricata notify test","category":"not-suspicious","severity":1}}'
}

run_worker() {
	mkdir -p "$QDIR" "$STATE"
	n=0
	while [ "$n" -lt 200 ]; do
		next=$(ls "$QDIR" 2>/dev/null | head -n 1)
		[ -n "$next" ] || break
		line=$(cat "$QDIR/$next" 2>/dev/null || true)
		rm -f "$QDIR/$next"
		process_line "$line"
		n=$((n + 1))
	done
}

enqueue_line() {
	line=$1
	mkdir -p "$QDIR"
	f="$QDIR/$(now_epoch).$$.$RANDOM"
	printf '%s\n' "$line" > "$f"
	if command -v flock >/dev/null 2>&1; then
		(
			flock -n 9 || exit 0
			run_worker
		) 9>"$LOCK" &
	else
		process_line "$line"
	fi
}

MODE=sync
TEST_ID=
while [ $# -gt 0 ]; do
	case "$1" in
		--enqueue) MODE=enqueue; shift ;;
		--test)
			MODE=test
			TEST_ID=$2
			shift 2
			;;
		--status) MODE=status; shift ;;
		--worker) MODE=worker; shift ;;
		--dry-run) DRY=1; shift ;;
		--) shift; break ;;
		-*) shift ;;
		*) break ;;
	esac
done

case "$MODE" in
	status)
		dump_status
		exit 0
		;;
	worker)
		if command -v flock >/dev/null 2>&1; then
			flock -n 9 || exit 0
			run_worker
		else
			run_worker
		fi
		exit 0
		;;
	test)
		[ -n "$TEST_ID" ] || exit 1
		parse_alert "$(synthetic_line)" || exit 1
		dispatch_channel "$TEST_ID" 1
		exit 0
		;;
	enqueue)
		if [ -n "$1" ]; then
			enqueue_line "$1"
		else
			while IFS= read -r line; do
				enqueue_line "$line"
			done
		fi
		exit 0
		;;
	*)
		if [ -n "$1" ]; then
			process_line "$1"
		else
			while IFS= read -r line; do
				process_line "$line"
			done
		fi
		exit 0
		;;
esac
