{
  "enable": true,
  "path": "/dev/ttyS2",
  "baud": 115200,
  "path_autodiscover": true,
  "wire_format": "json",
  "max_line": 4096,
  "pages": "/etc/mcud/pages.json",
  "demo_mode": false,
  "screen_timeout": 60,
  "screen_timeout_mode": "off",
  "push_alerts": true,
  "wan_if": "wan",
  "lan_if": "br-lan",
  "wifi_if": "wlan0",
  "interval_system": 1000,
  "interval_network": 2000,
  "log_level": "info",
  "debug": false,
  "debug_serial": false,
  "menu_nav_button": "BTN_2",
  "menu_select_button": "wps",
  "menu_wps": false
}
