#!/bin/sh /etc/rc.common

START=12
STOP=88
USE_PROCD=1
PROG=/usr/sbin/mcudd
BOOT_STATE=/usr/lib/mcud/mcud-boot-state.sh

mcud_instance() {
	local section="$1"
	local cfg_enable cfg_path retries=0

	config_get cfg_enable "$section" enable
	config_get cfg_path "$section" path

	[ "$cfg_enable" = "1" ] || return 1
	[ -n "$cfg_path" ] || {
		logger -t mcudd "missing UCI option path"
		return 1
	}

	while [ ! -c "$cfg_path" ] && [ "$retries" -lt 15 ]; do
		sleep 1
		retries=$((retries + 1))
	done

	procd_open_instance
	procd_set_param command ${PROG}
	# Do not attach procd stdout/stderr pipes — fmt/log writes can block the
	# UART poll loop when logd back-pressures. mcudd logs via syslog itself.
	procd_set_param respawn 3600 5 0
	procd_close_instance
	MCUD_STARTED=1
}

mcud_wait_ready() {
	(
		local retries=0 fifo=""

		while [ "$retries" -lt 30 ]; do
			pidof mcudd >/dev/null 2>&1 || {
				retries=$((retries + 1))
				sleep 1
				continue
			}
			for fifo in /var/run/mcudd.fifo /tmp/mcudd.fifo; do
				[ -p "$fifo" ] && break
			done
			[ -p "$fifo" ] || {
				retries=$((retries + 1))
				sleep 1
				continue
			}
			[ -x "$BOOT_STATE" ] && "$BOOT_STATE" ready "System ready" 100
			exit 0
		done
		logger -t mcudd-boot "timeout waiting for mcudd ready"
	) &
}

start_service() {
	MCUD_STARTED=0
	[ -x /usr/lib/mcud/mcud-autodiscover.sh ] && /usr/lib/mcud/mcud-autodiscover.sh --apply
	[ -x "$BOOT_STATE" ] && "$BOOT_STATE" boot "Starting mcudd..." 15
	# Cache host version for LuCI — do not exec the Go binary from rpcd.
	[ -x "$PROG" ] && "$PROG" -version-json > /tmp/mcud_host_version.json 2>/dev/null || true
	config_load mcud
	config_foreach mcud_instance mcud
	[ "$MCUD_STARTED" = 1 ] && mcud_wait_ready
}

stop_service() {
	killall mcudd 2>/dev/null
}

service_triggers() {
	procd_add_reload_trigger "mcud"
}
