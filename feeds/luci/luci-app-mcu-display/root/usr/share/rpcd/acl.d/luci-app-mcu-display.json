{
	"luci-app-mcu-display": {
		"description": "Grant access for luci-app-mcu-display (ESP32 UART display)",
		"read": {
			"ubus": {
				"luci.mcu-display": [
					"getConfig",
					"getStatus",
					"getPageList",
					"listSerialPorts",
					"getLogs"
				]
			},
			"uci": [ "mcud" ],
			"file": {
				"/etc/mcud/pages.json": [ "read" ],
				"/tmp/mcud_state": [ "read" ],
				"/tmp/mcud_active_screen": [ "read" ],
				"/dev/ttyUSB*": [ "read" ],
				"/dev/ttyS*": [ "read" ],
				"/dev/ttyACM*": [ "read" ],
				"/sbin/logread": [ "exec" ],
				"/bin/logread": [ "exec" ]
			}
		},
		"write": {
			"ubus": {
				"luci.mcu-display": [
					"setConfig",
					"serviceControl",
					"pageControl",
					"autodiscoverPort"
				]
			},
			"uci": [ "mcud" ],
			"file": {
				"/etc/init.d/mcudd": [ "exec" ],
				"/usr/lib/mcud/mcud-event.sh": [ "exec" ]
			}
		}
	}
}
