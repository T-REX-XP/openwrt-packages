#!/bin/sh
# Build Snort 3 SID states, pass-list rules, and suppress.lua from UCI.
set -eu

STATES=${1:-/var/snort.d/ips.states}
PASS=${2:-/var/snort.d/snort-pass-list.rules}
SUP=${3:-/var/snort.d/suppress.lua}
SKIP=${4:-/var/snort.d/skip-rules}
STMP=$(mktemp)
PTMP=$(mktemp)
UTMP=$(mktemp)
KTMP=$(mktemp)
trap 'rm -f "$STMP" "$PTMP" "$UTMP" "$KTMP"' EXIT

mkdir -p "$(dirname "$STATES")" "$(dirname "$PASS")" "$(dirname "$SUP")" "$(dirname "$SKIP")"

ip_ok() {
	echo "$1" | grep -qE '^[0-9A-Fa-f.:/]+$' || return 1
	case "$1" in
		''|*[!0-9A-Fa-f.:/]*) return 1 ;;
	esac
	[ "${#1}" -le 64 ]
}

pass_flag() {
	uci -q get "snort.pass.$1" 2>/dev/null || echo 0
}

sid_from_ip() {
	echo "$1" | awk -F'[./:]' '{
		n = 9000000
		for (i = 1; i <= NF; i++) {
			if ($i ~ /^[0-9]+$/) n += ($i % 97) * (i + 1)
		}
		print n
	}'
}

emit_pass() {
	ip_ok "$1" || return 0
	sid=$(sid_from_ip "$1")
	echo "pass ip $1 any -> any any (msg:\"pass-list $1\"; sid:$sid; gid:1; rev:1;)"
	echo "pass ip any any -> $1 any (msg:\"pass-list-dst $1\"; sid:$((sid + 1)); gid:1; rev:1;)"
}

{
	echo "# generated by snort-rules-apply"
	if command -v uci >/dev/null 2>&1; then
		uci -q show snort 2>/dev/null | sed -n 's/^snort\.s\([0-9][0-9]*\)=sid$/\1/p' | while read -r sid; do
			[ -n "$sid" ] || continue
			en=$(uci -q get "snort.s${sid}.enabled" 2>/dev/null || echo 1)
			status=$(uci -q get "snort.s${sid}.status" 2>/dev/null || echo enabled)
			gid=$(uci -q get "snort.s${sid}.gid" 2>/dev/null || echo 1)
			case "$gid" in
				''|*[!0-9]*) gid=1 ;;
			esac
			if [ "$en" = 0 ] || [ "$status" = disabled ] || [ "$status" = expired ]; then
				echo "alert ( gid:$gid; sid:$sid; enable:no; )"
			fi
		done
	fi
} > "$STMP"

{
	echo "# generated by snort-rules-apply — pass list"
	if command -v uci >/dev/null 2>&1; then
		if [ "$(pass_flag local_nets)" = 1 ]; then
			lan=$(uci -q get network.lan.ipaddr 2>/dev/null || true)
			[ -n "$lan" ] && emit_pass "$lan"
		fi
		if [ "$(pass_flag wan_gateway)" = 1 ]; then
			gw=$(ip -4 route show default 2>/dev/null | awk '{print $3; exit}')
			[ -n "$gw" ] && emit_pass "$gw"
		fi
		if [ "$(pass_flag wan_dns)" = 1 ]; then
			if [ -f /tmp/resolv.conf.d/resolv.conf.auto ]; then
				awk '/^nameserver[ \t]+/ { print $2 }' /tmp/resolv.conf.d/resolv.conf.auto | while read -r ns; do
					[ -n "$ns" ] && emit_pass "$ns"
				done
			fi
		fi
		if [ "$(pass_flag vpn_addrs)" = 1 ]; then
			ip -o -4 addr show 2>/dev/null | awk '{
				gsub(/:.*/, "", $2)
				if ($2 ~ /^(wg|tailscale|tun)/)
					print $4
			}' | while read -r cidr; do
				[ -n "$cidr" ] && emit_pass "$cidr"
			done
		fi
		uci -q get snort.pass.ip 2>/dev/null | tr ' \t' '\n' | while read -r ip; do
			[ -n "$ip" ] && emit_pass "$ip"
		done
	fi
} > "$PTMP"

{
	echo "-- generated by snort-rules-apply"
	echo "suppress = {"
	if command -v uci >/dev/null 2>&1; then
		i=0
		while uci -q get "snort.@suppress[$i]" >/dev/null 2>&1; do
			sid=$(uci -q get "snort.@suppress[$i].sid" 2>/dev/null || true)
			gid=$(uci -q get "snort.@suppress[$i].gid" 2>/dev/null || echo 1)
			track=$(uci -q get "snort.@suppress[$i].track" 2>/dev/null || echo by_src)
			ip=$(uci -q get "snort.@suppress[$i].ip" 2>/dev/null || true)
			case "$sid" in
				''|*[!0-9]*) i=$((i + 1)); continue ;;
			esac
			case "$gid" in
				''|*[!0-9]*) gid=1 ;;
			esac
			case "$track" in
				by_src|by_dst) ;;
				*) track=by_src ;;
			esac
			if ip_ok "$ip"; then
				echo "  { gid = $gid, sid = $sid, track = '$track', ip = '$ip' },"
			fi
			i=$((i + 1))
		done
	fi
	echo "}"
} > "$UTMP"

{
	if command -v uci >/dev/null 2>&1; then
		i=0
		while uci -q get "snort.@rulefile[$i]" >/dev/null 2>&1; do
			file=$(uci -q get "snort.@rulefile[$i].file" 2>/dev/null || true)
			en=$(uci -q get "snort.@rulefile[$i].enabled" 2>/dev/null || echo 1)
			case "$file" in
				''|*/*|*..*) i=$((i + 1)); continue ;;
			esac
			echo "$file" | grep -qE '^[A-Za-z0-9._-]+\.rules$' || { i=$((i + 1)); continue; }
			if [ "$en" = 0 ]; then
				echo "$file"
			fi
			i=$((i + 1))
		done
	fi
} > "$KTMP"

mv "$STMP" "$STATES"
mv "$PTMP" "$PASS"
mv "$UTMP" "$SUP"
mv "$KTMP" "$SKIP"
chmod 644 "$STATES" "$PASS" "$SUP" "$SKIP"
trap - EXIT
exit 0
