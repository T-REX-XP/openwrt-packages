{
	"luci-app-snort3": {
		"description": "Grant access for luci-app-snort3",
		"read": {
			"ubus": {
				"luci.snort3": [
					"getStatus",
					"getConfig",
					"getAlerts",
					"updateStatus",
					"getRules",
					"getPolicies",
					"getNotify"
				]
			},
			"uci": [ "snort" ],
			"file": {
				"/usr/share/luci-app-snort3/ruleset-catalog.json": [ "read" ],
				"/usr/bin/snort": [ "exec" ],
				"/etc/init.d/snort": [ "exec" ],
				"/etc/init.d/snort-notify": [ "exec" ],
				"/usr/sbin/tp-notify": [ "exec" ],
				"/var/log/alert_fast.txt": [ "read" ],
				"/var/log/*alert_json.txt": [ "read" ],
				"/tmp/snort_rules_update.log": [ "read" ],
				"/tmp/snort_rules_update.lock": [ "read" ],
				"/proc/meminfo": [ "read" ],
				"/proc/*/status": [ "read" ],
				"/sbin/uci": [ "exec" ],
				"/usr/bin/uci": [ "exec" ],
				"/bin/pidof": [ "exec" ],
				"/usr/bin/pidof": [ "exec" ],
				"/usr/bin/wc": [ "exec" ],
				"/usr/bin/tail": [ "exec" ],
				"/usr/bin/find": [ "exec" ],
				"/bin/readlink": [ "exec" ],
				"/usr/bin/readlink": [ "exec" ],
				"/sbin/logread": [ "exec" ],
				"/usr/bin/logread": [ "exec" ],
				"/usr/sbin/sqlite3": [ "exec" ],
				"/usr/bin/sqlite3": [ "exec" ],
				"/var/lib/snort/rules.sqlite": [ "read" ]
			}
		},
		"write": {
			"ubus": {
				"luci.snort3": [
					"setConfig",
					"serviceControl",
					"updateRules",
					"fixRules",
					"cleanupTemp",
					"setRuleStates",
					"reindexRules",
					"setPolicies",
					"setNotify",
					"notifyTest"
				]
			},
			"uci": [ "snort" ],
			"file": {
				"/etc/init.d/snort": [ "exec" ],
				"/etc/init.d/snort-notify": [ "exec" ],
				"/usr/sbin/tp-notify": [ "exec" ],
				"/usr/bin/snort-rules": [ "exec" ],
				"/usr/bin/snort-mgr": [ "exec" ],
				"/usr/sbin/snort-rules-index": [ "exec" ],
				"/usr/sbin/snort-rules-apply": [ "exec" ],
				"/sbin/uci": [ "exec" ],
				"/usr/bin/uci": [ "exec" ],
				"/bin/ln": [ "exec" ],
				"/bin/rm": [ "exec" ],
				"/bin/mv": [ "exec" ],
				"/bin/touch": [ "exec" ],
				"/tmp/snort_rules_update.log": [ "write" ],
				"/tmp/snort_rules_update.lock": [ "write" ],
				"/etc/snort/rules": [ "write" ],
				"/var/snort.d/*.tar.gz": [ "write" ],
				"/var/snort.d/ips.states": [ "write" ],
				"/var/snort.d/snort-pass-list.rules": [ "write" ],
				"/var/snort.d/suppress.lua": [ "write" ],
				"/var/snort.d/skip-rules": [ "write" ],
				"/var/lib/snort/rules.sqlite": [ "write" ]
			}
		}
	}
}
